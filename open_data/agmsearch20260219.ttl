ag: a owl:Ontology ;
    rdfs:label "Analog Game Ontology"@en,
        "アナログゲームオントロジー"@ja ;
    dcterms:created "2021-06-01" ;
    dcterms:license "CC0 1.0 Universal" ;
    dcterms:modified "2023-02-22" ;
    vann:preferredNamespacePrefix "ag" ;
    rdfs:comment "アナログゲームおよびその関連資料に関する書誌世界を記述するウェブオントロジー"@ja ;
    owl:versionInfo 0.8 .

ag:AdminMetadata a owl:Class ;
    rdfs:label "Admin Metadata"@en,
        "管理メタデータ"@ja ;
    rdfs:comment "メタデータをリソースとする管理情報"@ja .

ag:Article a owl:Class ;
    rdfs:label "Article"@en,
        "記事"@ja ;
    rdfs:subClassOf ag:Instance .

ag:AudioMaterial a owl:Class ;
    rdfs:label "Audio Material"@en,
        "音声資料"@ja ;
    rdfs:subClassOf ag:Instance .

ag:Book a owl:Class ;
    rdfs:label "Book"@en,
        "図書"@ja ;
    rdfs:subClassOf ag:Volume .

ag:Card a owl:Class ;
    rdfs:label "Card"@en,
        "カード"@ja ;
    rdfs:subClassOf ag:Instance .

ag:FictionalPlace a owl:Class ;
    rdfs:label "虚構の場所"@ja ;
    rdfs:subClassOf ag:Place .

ag:FictionalTimespan a owl:Class ;
    rdfs:label "虚構の時期"@ja ;
    rdfs:subClassOf ag:Timespan .

ag:Flyer a owl:Class ;
    rdfs:label "Flyer"@en,
        "フライヤー"@ja ;
    rdfs:subClassOf ag:Instance .

ag:GameComponent a owl:Class ;
    rdfs:label "Game Component"@en,
        "ゲームコンポーネント"@ja ;
    rdfs:subClassOf ag:Instance .

ag:GamePlatform a owl:Class ;
    rdfs:label "ゲームプラットフォーム"@ja ;
    rdfs:subClassOf ag:ControlledVocabulary .

ag:Journal a owl:Class ;
    rdfs:label "Journal"@en,
        "ジャーナル"@ja ;
    rdfs:subClassOf ag:Periodical .

ag:Magazine a owl:Class ;
    rdfs:label "Magazine"@en,
        "雑誌"@ja ;
    rdfs:subClassOf ag:Periodical .

ag:MediaType a owl:Class ;
    rdfs:label "Media Type"@en,
        "メディア種別"@ja ;
    rdfs:subClassOf ag:ControlledVocabulary .

ag:Pamphlet a owl:Class ;
    rdfs:label "Pamphlet"@en,
        "パンフレット"@ja ;
    rdfs:subClassOf ag:Instance .

ag:VisualAudioMaterial a owl:Class ;
    rdfs:label "Audio Visual Material"@en,
        "視聴覚資料"@ja ;
